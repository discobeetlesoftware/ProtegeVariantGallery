---
import { type Button } from "../models";
import ButtonTableVariant from "./ButtonTableVariant.astro";

interface Props {
    buttons: Button[];
}

const { buttons } = Astro.props;
---

<div id="button_variants">
    <h2>Buttons</h2>
    <table>
        <thead>
            <tr>
                <th>Proof</th>
                <th>Design</th>
                <th>Image</th>
                <th>Variant</th>
                <th>Origin</th>
                <th>Finish</th>
                <th>Edge</th>
                <th>Total Produced</th>
            </tr>
        </thead>
        {
            buttons.map((button, index) => (
                <ButtonTableVariant button={button} />
            ))
        }
    </table>
</div>
