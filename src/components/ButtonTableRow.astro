---
import { type Button, type ButtonVariant } from "../models";
import LocalImage from "./LocalImage.astro";
import GalleryElement from "./GalleryElement.astro";

interface Props {
    button: Button;
    buttonVariant: ButtonVariant;
    index: number;
}

const { button, buttonVariant, index } = Astro.props;
const name = `${button.name.en} v${index}`;
const anchor = name.replace(/[(]|[)]|[-]|\s/g, "_");
const themeKey = button.name.en.replace(/[(]|[)]|[-]|\s/g, "");
---

<tbody class={themeKey}>
    <tr id={anchor}>
        <td>{button.name.en}</td>
        <td
            ><LocalImage
                subdir="proofs"
                key={buttonVariant.proof ?? ''}
                alt={`${name} proof`}
                width={200}
            /></td
        >
        <td><GalleryElement imageName={buttonVariant.image} variantName={name} /></td>
        <td><a href={`/ProtegeVariantGallery#${anchor}`}>v{index}</a></td>
        <td>{buttonVariant.origin}</td>
        <td>{buttonVariant.finish}</td>
        <td>{buttonVariant.edge}</td>
        <td>{[buttonVariant.total ?? "Unknown"].flat().join(', ')}</td>
    </tr>
</tbody>

<style define:vars={{ color: buttonVariant.color }}>
    tbody :global(td:nth-child(1)) {
        background-image: linear-gradient(
            to right,
            var(--color) 0%,
            var(--color) 5%,
            white 100%
        );
    }
</style>
