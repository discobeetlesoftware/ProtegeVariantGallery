---
import Layout from "../layouts/Layout.astro";
import Description from "@components/Description.astro";
import Info from "@components/Info.astro";
import Resources from "@components/Resources.astro";
import ChipTable from "@components/ChipTable.astro";
import ButtonTable from "@components/ButtonTable.astro";
import PlaqueTable from "@components/PlaqueTable.astro";
import RarityScale from "@components/RarityScale.astro";
import { rarityCounts, protege } from "src/Variants";
---

<Layout title="BCC Protégé Variants">
	<main>
		<Description />
		<Info
			denominationCount={protege.count.chips.total}
			plaqueCount={protege.count.plaques.total}
			buttonCount={protege.count.buttons.total}
			variantCount={protege.count.chips.variants}
		/>
		<Resources />
		<RarityScale counts={rarityCounts} />
		<div id="gallery-container">
			<ChipTable chips={protege.chips} />
			<ButtonTable buttons={protege.buttons} />
			<PlaqueTable
				prefix="Ceramic"
				isExtended={false}
				plaques={protege.ceramicPlaques}
			/>
			<PlaqueTable
				prefix="Matsui"
				isExtended={true}
				plaques={protege.matsuiPlaques}
			/>
		</div>
	</main>
</Layout>
