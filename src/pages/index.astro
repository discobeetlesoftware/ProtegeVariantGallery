---
import Layout from "../layouts/Layout.astro";
import Description from "@components/Description.astro";
import Info from "@components/Info.astro";
import Resources from "@components/Resources.astro";
import ChipTable from "@components/ChipTable.astro";
import ButtonTable from "@components/ButtonTable.astro";
import PlaqueTable from "@components/PlaqueTable.astro";
import RarityScale from "@components/RarityScale.astro";
import { Controller } from "../controller";
import { rarityCounts, variants } from "src/variants";
---

<Layout title="BCC Protégé Variants">
	<main>
		<Description />
		<Info
			denominationCount={variants.counts.chips}
			plaqueCount={variants.plaquesTotal}
			buttonCount={variants.counts.buttons}
			variantCount={variantCount}
		/>
		<Resources />
		<RarityScale counts={rarityCounts} />
		<div id="gallery-container">
			<ChipTable chips={variants.chips} />
			<ButtonTable buttons={variants.buttons} />
			<PlaqueTable
				prefix="Ceramic"
				isExtended={false}
				plaques={variants.ceramicPlaques}
			/>
			<PlaqueTable
				prefix="Matsui"
				isExtended={true}
				plaques={variants.matsuiPlaques}
			/>
		</div>
	</main>
</Layout>
